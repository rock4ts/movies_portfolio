PROJECT_NAME="Movie theater"
PROJECT_DESCRIPTION="The best movie theater for averyone"

# Containerized run defaults
DEBUG=False
SECRET_KEY=secret_key # Change this to a random secret key

POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=theatre
# Docker network host
POSTGRES_HOST=postgres-admin
POSTGRES_PORT=5432
POSTGRES_OPTIONS="-c search_path=public"

AUTH_API_LOGIN_URL=http://auth-api:8000/auth/api/token
AUTHJWT_PUBLIC_KEY_PATH=/run/secrets/jwt/jwt-public.pem
BREAK_GLASS_EMAIL=break-glass@admin.ru

# Load database_dump.sql after migrations on startup
LOAD_DATABASE_DUMP=true
