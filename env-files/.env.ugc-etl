KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_TOPICS=ugc-events,ugc-anonymous-events
KAFKA_GROUP_ID=ugc-etl
KAFKA_DLQ_TOPIC=ugc-events-dlq
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_INTERVAL_MS=300000

CLICKHOUSE_HOST=clickhouse-node1
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=etl_writer
CLICKHOUSE_DATABASE=ugc
CLICKHOUSE_ETL_PASSWORD=etl_password
CLICKHOUSE_TABLE=events_raw

ETL_BATCH_SIZE=5000
ETL_FLUSH_INTERVAL_SECONDS=2
ETL_RETRY_MAX_ATTEMPTS=5
ETL_RETRY_BASE_SECONDS=1
LOG_LEVEL=INFO
