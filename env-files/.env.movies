PROJECT_NAME=MoviesAPI

DEBUG=False
LOG_FILE_PATH=/var/log/movies-api/app.json
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7
FILM_INDEX=movies
GENRE_INDEX=genres
PERSON_INDEX=persons
AUTHJWT_SECRET_KEY=change-me-in-production

REDIS_HOST=redis
