PROJECT_NAME=MoviesAPI

DEBUG=False
LOG_FILE_PATH=/var/log/movies-api/app.json
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7
FILM_INDEX=movies
GENRE_INDEX=genres
PERSON_INDEX=persons
AUTHJWT_SECRET_KEY=change-me-in-production

REDIS_HOST=redis
REDIS_PORT=6379

ELASTIC_HOST=elastic-db
ELASTIC_PORT=9200
CACHE_TTL=300
PUBLIC_KEY_PATH=/run/secrets/jwt/jwt-public.pem

SENTRY_ENABLED=false
# Copy the movies-api DSN from http://sentry.localhost, then replace only the host with sentry-api:9000.
SENTRY_DSN=http://YOUR_PROJECT_KEY@sentry-api:9000/YOUR_PROJECT_ID
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
