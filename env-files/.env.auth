DEBUG=false
PROD_RUN=false
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=password

POSTGRES_HOST=postgres-auth
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=auth

REDIS_HOST=redis
REDIS_PORT=6379

PRIVATE_KEY_PATH=/run/secrets/jwt/jwt-private.pem
PUBLIC_KEY_PATH=/run/secrets/jwt/jwt-public.pem

TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_PREFIX=rate_limit
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_IP_LIMIT=5
RATE_LIMIT_IP_WINDOW_SECONDS=60

TRACING_ENABLED=true
REQUEST_ID_HEADER=x-request-id
OTEL_SERVICE_NAME=auth-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger-tracer:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Use 1.0 for local/dev only; lower production sampling to 0.1 or 0.01.
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_PYTHON_REDIS_CAPTURE_STATEMENT=false

YANDEXID_AUTH_URL=https://oauth.yandex.ru/authorize
YANDEXID_TOKEN_URL=https://oauth.yandex.ru/token
YANDEXID_USER_INFO_URL=https://login.yandex.ru/info
YANDEXID_REDIRECT_URL=https://oauth.yandex.ru/verification_code
YANDEXID_CLIENT_ID=41245e368c414be3bc1e8d172c9be2e6
YANDEXID_CLIENT_SECRET=eeb9614f93854b9797496a20daef529b
YANDEX_CONFIRMATION_CODE_TTL=600
