FLASK_ENV=production
DEBUG=false

KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_TOPIC=ugc-events
KAFKA_ANONYMOUS_TOPIC=ugc-anonymous-events
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_LINGER_MS=20
KAFKA_BATCH_SIZE=65536

PUBLIC_KEY_PATH=/run/secrets/jwt/jwt-public.pem
PUBLIC_URL_PREFIX=/ugc
