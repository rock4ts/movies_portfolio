PROJECT_DIR=/workspace # set this to the host absolute path of the repo (the bind mount must use that same path so Compose can see the project and the host Docker daemon can resolve relative paths)
COMPOSE_FILE=docker-compose.yml
SERVICE=ugc-etl
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_TOPICS=ugc-events,ugc-anonymous-events
GROUP_ID=ugc-etl
MIN_WORKERS=1
MAX_WORKERS=4
SINGLE_WORKER_THROUGHPUT=150000
ADDITIONAL_WORKER_THROUGHPUT=15000
TARGET_DRAIN_SECONDS=600
TARGET_UTILIZATION=0.8
SCALE_DOWN_UTILIZATION=0.6
COOLDOWN_SECONDS=300
COMMAND_TIMEOUT_SECONDS=60
KAFKA_TIMEOUT_SECONDS=30
STATE_FILE=/var/lib/ugc-etl-scaler/state.json
DRY_RUN=false
LOG_LEVEL=INFO
